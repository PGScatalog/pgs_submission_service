runtime: python313

service: <service_name>

automatic_scaling:
  min_instances: 0
  max_instances: 1
  min_idle_instances: 0
  max_idle_instances: 1

env_variables:
    DEBUG: "false"
    SECURED: "true"
    LOCAL_PUBLIC_KEY_FILE: ""
    GCP_PROJECT_NAME: ""
    JWT_ISSUERS: '{"first-app": {"secret_name": "key-name-public"}, "<other-app>": {"secret_name": "other-key-public"}}'
    JWT_EXPECTED_AUDIENCE: ""

    FIRESTORE_PROJECT_ID: ""
    FIRESTORE_DATABASE_ID: ""

    GCS_BUCKET_NAME: ""

    GCT_QUEUE_NAME: ""
    GCT_LOCATION: ""
    GCT_SERVICE_ACCOUNT: ""

    GLOBUS_MAPPED_COLLECTION_ID: ""
    GLOBUS_ENDPOINT_HOSTNAME: ""
    GLOBUS_ENDPOINT_ID: ""
    GLOBUS_STORAGE_GATEWAY_ID: ""
    GLOBUS_CLIENT_ID: ""
    GLOBUS_CLIENT_SECRET: ""
    GLOBUS_PGS_IDENTITY: ""
    GLOBUS_PGS_GLOBUS_GROUP: ""
    GLOBUS_FTP_ROOT_DIR: ""

    METADATA_FILE_TRANSFER_ENABLED="true"
    GOOGLE_SERVICE_ACCOUNT_KEY_PATH=""
    GOOGLE_DRIVE_SHARED_FOLDER_ID=""